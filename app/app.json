{
  "expo": {
    "name": "Ahlam",
    "slug": "ahlam",
    "scheme": "ahlam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.ahlam.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Ahlam uses the camera to photograph auto parts for identification.",
        "NSPhotoLibraryUsageDescription": "Ahlam lets you upload part photos from your library."
      }
    },
    "android": {
      "package": "io.ahlam.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ahlam uses the camera to photograph auto parts."
        }
      ],
      "expo-image-picker"
    ],
    "extra": {
      "router": { "origin": false }
    }
  }
}
