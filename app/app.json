{
  "expo": {
    "name": "Ahlam",
    "slug": "ahlam",
    "scheme": "ahlam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.ahlam.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ahlam uses the camera to photograph auto parts for identification.",
        "NSPhotoLibraryUsageDescription": "Ahlam lets you upload part photos from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.ahlam.app",
      "versionCode": 1,
      "permissions": ["CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Ahlam uses the camera to photograph auto parts.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-image-picker",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": { "origin": false },
      "eas": {
        "projectId": "a6d3a63f-0c10-4b6e-a18e-dda473025d7f"
      }
    },
    "owner": "ahlamio"
  }
}
