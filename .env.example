# ============================================================================
# CaroSpecs environment variables
# Copy to web/.env.local and app/.env and fill in. NEVER commit real keys.
# ============================================================================

# --- OpenAI (GPT-4o Vision: part ID + condition grading) --------------------
# Server-side only. Do NOT expose to the client / mobile app directly —
# proxy AI calls through a server route so the key is never shipped in the app.
OPENAI_API_KEY=sk-...

# --- Supabase (DB + Auth + Storage) -----------------------------------------
# Public (safe to ship to client):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# For the Expo app (Expo only exposes vars prefixed EXPO_PUBLIC_):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey...
# Server-side only — full access, used by API routes / edge functions. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Email (waitlist confirmation + internal "AI is down" alerts) -----------
# Using Resend (https://resend.com). Swap for Postmark if you prefer.
RESEND_API_KEY=re_...
WAITLIST_FROM_EMAIL=hello@carospecs.com
# Where the "out of credits / API error" emergency alerts go (CEO/CTO):
ALERT_EMAIL=mohammad@atomgrants.com

# --- Google OAuth (Sign in with Google) -------------------------------------
# Configure in Supabase Auth > Providers > Google. These live in Supabase,
# not here, but kept for reference:
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# --- VIN decode (FREE, no key) ----------------------------------------------
# NHTSA vPIC API: https://vpic.nhtsa.dot.gov/api/  — no key required.

# --- Marketplaces -----------------------------------------------------------
# Facebook Marketplace: NO public listing API. Copy-paste / file export only.
# OfferUp: treated the same as Facebook for v1 (copy-paste / file export).
# eBay (optional, future): https://developer.ebay.com
# EBAY_APP_ID=
