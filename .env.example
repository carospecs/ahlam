# ============================================================================
# Ahlam environment variables
# Copy to web/.env.local and app/.env and fill in. NEVER commit real keys.
# ============================================================================

# --- OpenAI (GPT-4o Vision: part ID + condition grading) --------------------
# Server-side only. Do NOT expose to the client / mobile app directly —
# proxy AI calls through a server route so the key is never shipped in the app.
OPENAI_API_KEY=sk-...

# --- Supabase (DB + Auth + Storage) -----------------------------------------
# Public (safe to ship to client):
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
# For the Expo app (Expo only exposes vars prefixed EXPO_PUBLIC_):
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ey...
# Server-side only — full access, used by API routes / edge functions. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=ey...

# --- Email (waitlist welcome + internal "AI is down" alerts) ----------------
# Sends through Google Workspace (Gmail) SMTP — no third-party email service.
# GMAIL_USER is the Workspace account that authenticates; GMAIL_APP_PASSWORD is
# a 16-char App Password (Google Account > Security > App passwords; requires
# 2-Step Verification enabled). https://myaccount.google.com/apppasswords
GMAIL_USER=mohammadabbas@ahlam.io
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# The visible From (can include a display name). Defaults to GMAIL_USER.
WAITLIST_FROM_EMAIL=Mohammad Abbas <mohammadabbas@ahlam.io>
# CC every signup to the team (comma-separated for multiple). Optional.
WAITLIST_CC_EMAIL=andygarcia@ahlam.io
# Where replies go. Optional — defaults to the From address.
WAITLIST_REPLY_TO=mohammadabbas@ahlam.io
# Where the "out of credits / API error" emergency alerts go (CEO/CTO):
ALERT_EMAIL=mohammad@atomgrants.com

# --- Google OAuth (Sign in with Google) -------------------------------------
# Configure in Supabase Auth > Providers > Google. These live in Supabase,
# not here, but kept for reference:
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# --- VIN decode (FREE, no key) ----------------------------------------------
# NHTSA vPIC API: https://vpic.nhtsa.dot.gov/api/  — no key required.

# --- Marketplaces -----------------------------------------------------------
# Facebook Marketplace: NO public listing API. Copy-paste / file export only.
# OfferUp: treated the same as Facebook for v1 (copy-paste / file export).

# --- Anthropic (Claude Sonnet / Haiku: part ID A/B test) --------------------
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- eBay Sell API (Export → "List on eBay") -------------------------------
# Full step-by-step + costs: docs/EBAY_SETUP.md
# Create an app at https://developer.ebay.com → keys are under "Application Keys".
# Use sandbox keys first, then production. EBAY_REDIRECT_URI is your RuName.
EBAY_ENV=sandbox                       # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=                     # the RuName from your eBay app's OAuth settings
NEXT_PUBLIC_SITE_URL=http://localhost:3217
# Required by eBay to publish (set up once in your eBay account / via API):
EBAY_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_CATEGORY_ID=6028                  # default: Other Car & Truck Parts

# --- Stripe (subscription billing + marketplace payments) -------------------
# Server-side only. Create keys at https://dashboard.stripe.com/apikeys
# Subscription billing (Billing page): needs STRIPE_SECRET_KEY + STRIPE_PRICE_ID.
# Marketplace payments (Buy now / escrow / payouts): needs STRIPE_SECRET_KEY,
# Connect enabled on the account, and STRIPE_WEBHOOK_SECRET for the webhook.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...              # the $49/mo subscription price
# Webhook signing secret — point a Stripe webhook at /api/payments/webhook and
# subscribe to: checkout.session.completed, account.updated
STRIPE_WEBHOOK_SECRET=whsec_...
# Ahlam's cut of each marketplace sale, in basis points (500 = 5%). Default 5%.
PLATFORM_FEE_BPS=500
